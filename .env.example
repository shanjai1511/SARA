# ══════════════════════════════════════════════════════════════════════════════
# SARA — Environment Configuration
# Copy this file to .env and fill in your values.
# Lines starting with # are comments and are ignored.
# ══════════════════════════════════════════════════════════════════════════════


# ── Message Broker (required) ─────────────────────────────────────────────────
# Full AMQP(S) connection URL.
# Local:  amqp://admin:password@localhost:5672/
# Cloud:  amqps://user:pass@host.cloudamqp.com/vhost   (CloudAMQP free tier works)
CLOUDAMQP_URL=


# ── Redis (strongly recommended) ──────────────────────────────────────────────
# Enables:
#   • Cross-run URL deduplication (Bloom filter)
#   • Cross-server crawl status visibility in the dashboard
#   • Shared per-domain rate limiting across all worker processes/servers
#   • Worker heartbeat / live worker registry
# If unset, all of the above fall back to local-file/in-process implementations
# (correct for single-machine dev, broken for multi-server production).
REDIS_URL=redis://localhost:6379/0


# ── Elasticsearch (optional) ──────────────────────────────────────────────────
# If set, parsed records are uploaded to ES after each crawl.
# Leave ELASTICSEARCH_URL blank to disable ES upload entirely.
ELASTICSEARCH_URL=https://localhost:9200
# API key auth (preferred for Elastic Cloud):
ELASTICSEARCH_API_KEY=
# Basic auth (for self-hosted):
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=


# ── AWS S3 (optional) ─────────────────────────────────────────────────────────
# When set, raw HTML is stored in S3 instead of local filesystem.
# Required for multi-server deployments where parser runs on a different server
# than the retriever (otherwise parser can't read the HTML files).
# Leave blank for local storage (default).
SARA_S3_BUCKET=
SARA_S3_PREFIX=raw
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1


# ── Dashboard / API ───────────────────────────────────────────────────────────
# Plaintext password required to access the Streamlit dashboard
DASHBOARD_PASSWORD=

# Bearer token for FastAPI control plane (/trigger, /status, etc.)
# Leave blank to run in unauthenticated dev mode.
SARA_API_KEY=


# ── Unblock Service ───────────────────────────────────────────────────────────
# URL of the sara-unblock service — anti-bot page fetching layer.
# Workers automatically fall back to this service when sites return 403/429/blocks.
# In docker-compose: http://sara-unblock:8888  (internal container DNS)
# Local dev:         http://localhost:8888
# Leave blank to disable the unblock layer (only direct+proxy strategies used).
SARA_UNBLOCK_URL=http://localhost:8888

# Bearer token protecting the unblock service API (leave blank = open/dev mode).
SARA_UNBLOCK_API_KEY=

# Maximum strategy index (0=direct only … 5=browser+proxy, default: 5).
# Set to 3 if you don't want Playwright (faster startup, less memory).
SARA_UNBLOCK_MAX_STRATEGY=5

# Uvicorn workers per unblock container (tune to your CPU cores / 2).
UNBLOCK_WORKERS=2


# ── Proxy credentials ─────────────────────────────────────────────────────────
# JSON array of [host, port, username, password] tuples — one entry per proxy.
# Set to [] or leave blank to disable proxies (fetches go direct).
# Example:
#   WEBSHARE_PROXY_JSON=[["p.webshare.io","80","user1","pass1"],["p.webshare.io","81","user2","pass2"]]
WEBSHARE_PROXY_JSON=


# ── Alerting — Slack (optional) ───────────────────────────────────────────────
# Incoming webhook URL from your Slack app (Settings > Incoming Webhooks).
ALERT_SLACK_WEBHOOK_URL=
# Set to "true" to also alert on successful crawl completions (default: false)
ALERT_NOTIFY_SUCCESS=false


# ── Alerting — Email (optional) ───────────────────────────────────────────────
# Comma-separated recipient address(es) for crawl failure alerts
ALERT_EMAIL_TO=
# Sender address shown in the From header
ALERT_EMAIL_FROM=sara-alerts@yourdomain.com
# SMTP server settings (Gmail example below)
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=


# ── Pipeline tuning (all optional — production-tuned defaults shown) ──────────

# Parallel HTTP workers per retriever run
# Rule of thumb: 8–16 for a 4-core server, 24–32 for an 8-core server
NUM_FETCH_WORKERS=8

# Parallel parse workers per parser run (CPU-bound — match to physical cores)
NUM_PARSE_WORKERS=8

# Parallel discovery workers per depth level
NUM_DISCOVERY_WORKERS=6

# Max discovery queue depth before discovery pauses (backpressure)
# Prevents the queue from growing to millions when retrieval is slow
DISCOVERY_BACKPRESSURE_THRESHOLD=50000

# Seconds between discovery calls within the same depth level (politeness)
FETCH_DELAY=2

# Seconds between individual URL fetches in retriever threads
FETCH_SLEEP_SEC=1

# Hard timeout per crawl job (seconds). Default: 8 hours.
CRAWL_TIMEOUT=28800


# ── Infrastructure passwords (for docker-compose) ─────────────────────────────
RABBITMQ_PASSWORD=changeme
GRAFANA_PASSWORD=admin


# ── Observability ─────────────────────────────────────────────────────────────
# Port for the Prometheus /metrics endpoint on each worker/API process
METRICS_PORT=8000

# CORS origins for the FastAPI control plane (comma-separated, or * for all)
CORS_ORIGINS=*
