# ── RabbitMQ ──────────────────────────────────────────────────────────────────
# Full AMQP(S) connection URL, e.g. amqps://user:pass@host/vhost
CLOUDAMQP_URL=

# ── Proxy credentials ─────────────────────────────────────────────────────────
# JSON array of [host, port, username, password] tuples (one entry per proxy)
# Example: [["198.23.239.134","6540","myuser","mypass"],["host2","port2","user","pass"]]
WEBSHARE_PROXY_JSON=

# ── Dashboard ─────────────────────────────────────────────────────────────────
# Plaintext password required to access the Streamlit dashboard
DASHBOARD_PASSWORD=

# ── Pipeline tuning (all optional — defaults shown) ───────────────────────────
# Number of parallel workers for URL retrieval
NUM_FETCH_WORKERS=4
# Number of parallel workers for HTML parsing
NUM_PARSE_WORKERS=4
# Max URLs pulled from the queue per retriever run
MAX_URLS=500
# Seconds to wait between discovery depth-level calls (politeness)
FETCH_DELAY=5
# Seconds to wait between individual URL fetches in retriever threads
FETCH_SLEEP_SEC=2
